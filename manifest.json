{
  "manifest_version": 3,
  "name": "Hover Translate - Instant Translation & Notes by JCS Labs",
  "version": "1.0.0",
  "description": "Hover over any text for instant translation. Take notes on useful translations. Supports 20+ languages. By JCS Labs.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Hover Translate by JCS Labs",
    "default_popup": "popup.html"
  },
  "permissions": [
    "contextMenus",
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://api.mymemory.translated.net/*",
    "https://libretranslate.com/*"
  ],
  "commands": {
    "toggle-hover": {
      "suggested_key": {
        "default": "Alt+J"
      },
      "description": "Toggle hover translation on/off"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_end"
    }
  ]
}
